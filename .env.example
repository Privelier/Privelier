# Public client configuration. Values in EXPO_PUBLIC_* are compiled into the
# app in plain text: only the project URL and the PUBLISHABLE key belong here
# (Supabase > Project Settings > API Keys). Never a secret or service_role key;
# lib/env.ts refuses to start with one.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Maps, address search and routing are free and need NO keys:
# MapLibre + OpenFreeMap tiles, Photon geocoding, FOSSGIS OSRM/Valhalla routing.
# Optional overrides, only if you self-host one of them later:
# EXPO_PUBLIC_PHOTON_URL=https://photon.example.com
# EXPO_PUBLIC_OSRM_URL=https://osrm.example.com
# EXPO_PUBLIC_VALHALLA_URL=https://valhalla.example.com

# Optional CAPTCHA (Cloudflare Turnstile, public values). Leave empty until
# Supabase > Authentication > Bot protection is enabled with the same site key.
# EXPO_PUBLIC_CAPTCHA_SITE_KEY=
# EXPO_PUBLIC_CAPTCHA_ORIGIN=https://privelier.app
