{
  "expo": {
    "name": "Privelier",
    "slug": "privelier",
    "version": "1.0.0",
    "scheme": "privelier",
    "orientation": "portrait",
    "icon": "./assets/privelier-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.privelier.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.privelier.app",
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/privelier-app-foreground.png",
        "monochromeImage": "./assets/privelier-app-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/privelier-favicon.png"
    },
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      [
        "expo-localization",
        {
          "supportedLocales": ["de", "en"]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Privelier to manage appointment events in your calendar.",
          "remindersPermission": "Allow Privelier to access calendar reminders."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#BFA06B",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/privelier-wordmark-white.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "4e46ae1b-e79e-4c7e-b407-7880f2cc047c"
      }
    }
  }
}
