{
  "expo": {
    "name": "Privelier",
    "slug": "privelier",
    "version": "1.0.0",
    "scheme": "privelier",
    "orientation": "portrait",
    "icon": "./assets/privelier-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.privelier.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.privelier.app",
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/privelier-app-foreground.png",
        "monochromeImage": "./assets/privelier-app-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/privelier-favicon.png"
    },
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "de",
            "en"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Privelier to add your appointments to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/privelier-wordmark-white.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Privelier to choose photos for your portfolio and verification documents.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Privelier uses your location while you travel to an appointment so your customer can see your live arrival time.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Privelier uses your location while you travel to an appointment so your customer can see your live arrival time.",
          "locationAlwaysPermission": "Privelier uses your location while you travel to an appointment so your customer can see your live arrival time.",
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#BFA06B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4e46ae1b-e79e-4c7e-b407-7880f2cc047c"
      }
    },
    "experiments": {
      "reactCompiler": true
    }
  }
}
